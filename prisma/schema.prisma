generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Servico {
  id           String   @id @default(cuid())
  nome         String
  duracaoMin   Int
  preco        Float
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  agendamentos Agendamento[]
  comissaoRegras ComissaoRegra[]
  // Profissionais que atendem este serviço. Lista vazia = atende quem não
  // tiver nenhum serviço vinculado (regra de retrocompatibilidade — ver
  // Profissional.servicos).
  profissionais Profissional[] @relation("ProfissionalServicos")
}

model Profissional {
  id           String   @id @default(cuid())
  nome         String
  especialidade String?
  telefone     String?
  ativo        Boolean  @default(true)
  comissaoPercentual Float @default(0)
  criadoEm     DateTime @default(now())
  agendamentos Agendamento[]
  comissaoRegras ComissaoRegra[]
  // Serviços que este profissional atende. Lista vazia = atende todos os
  // serviços (retrocompatibilidade — Story 5.1). A restrição só passa a
  // valer quando pelo menos um serviço é vinculado explicitamente.
  servicos     Servico[] @relation("ProfissionalServicos")
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime @default(now())
  agendamentos Agendamento[]
}

model Agendamento {
  id             String   @id @default(cuid())
  inicio         DateTime
  fim            DateTime
  status         String   @default("AGENDADO") // AGENDADO | CONCLUIDO | CANCELADO | FALTOU
  valorCobrado   Float?
  observacoes    String?
  criadoEm       DateTime @default(now())

  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  clienteId      String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId String
  servico        Servico      @relation(fields: [servicoId], references: [id])
  servicoId      String
  pagamentos     Pagamento[]

  @@index([inicio])
}

model Pagamento {
  id             String   @id @default(cuid())
  agendamento    Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  agendamentoId  String
  valor          Float
  formaPagamento String   // DINHEIRO | PIX | DEBITO | CREDITO
  dataHora       DateTime @default(now())
  conferido      Boolean  @default(false)
  criadoEm       DateTime @default(now())

  @@index([dataHora])
  @@index([agendamentoId])
}

model ComissaoRegra {
  id             String   @id @default(cuid())
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  profissionalId String
  servico        Servico? @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  servicoId      String?  // null = regra geral do profissional; preenchido = regra específica de um serviço
  percentual     Float
  criadoEm       DateTime @default(now())

  @@unique([profissionalId, servicoId])
}

model Usuario {
  id        String   @id @default(cuid())
  usuario   String   @unique
  senhaHash String
  papel     String   @default("DONO") // DONO | BALCAO (papel é usado a partir da Story 2.2)
  criadoEm  DateTime @default(now())
}

model FechamentoCaixa {
  id              String   @id @default(cuid())
  data            DateTime @unique
  totalDinheiro   Float
  totalPix        Float
  totalDebito     Float
  totalCredito    Float
  totalGeral      Float
  qtdAtendimentos Int
  ticketMedio     Float
  totalTaxas      Float    @default(0)
  totalLiquido    Float    @default(0)
  observacoes     String?
  criadoEm        DateTime @default(now())
}

model TaxaPagamento {
  id             String   @id @default(cuid())
  formaPagamento String   @unique // DINHEIRO | PIX | DEBITO | CREDITO
  percentual     Float    @default(0)
  valorFixo      Float    @default(0)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
}

// Singleton (id fixo "singleton") — configuração única do salão.
model Config {
  id           String   @id @default("singleton")
  comissaoBase String   @default("BRUTO") // BRUTO | LIQUIDO
  atualizadoEm DateTime @updatedAt
}

model Produto {
  id            String   @id @default(cuid())
  nome          String
  categoria     String?
  unidade       String?
  estoqueMinimo Float    @default(0)
  // Nasce em 0 e só muda via movimentação de estoque (Story 3.2). Nenhuma
  // action da Story 3.1 escreve neste campo diretamente.
  estoqueAtual  Float    @default(0)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
}
